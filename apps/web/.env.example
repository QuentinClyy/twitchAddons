# Optional: raises HenrikDev API rate limits. Get one from their Discord.
# https://docs.henrikdev.xyz/
VITE_HENRIK_API_KEY=

# Twitch channel (login name, not display name) whose chat is shown on the 3D scene's screen.
# Connects anonymously/read-only over Twitch's IRC-over-WebSocket gateway, no token needed.
VITE_TWITCH_CHANNEL=
