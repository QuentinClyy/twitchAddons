# Optional: raises HenrikDev API rate limits. Get one from their Discord.
# https://docs.henrikdev.xyz/
VITE_HENRIK_API_KEY=

# Streamlabs Chatbox widget URL shown on the 3D scene's screen (streamlabs.com/dashboard widget settings).
# Loaded via an iframe with referrerpolicy="no-referrer" so Streamlabs doesn't reject the embed.
VITE_STREAMLABS_WIDGET_URL=
